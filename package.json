{
  "name": "mural",
  "version": "0.1.0",
  "description": "Console TypeScript application",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mural": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/runtime/model.test.ts",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
