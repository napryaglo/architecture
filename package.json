{
  "name": "mural",
  "version": "0.1.0",
  "description": "Console TypeScript application",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mural": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "demo:border": "tsx src/Controls/tests/border-render.ts",
    "demo:text": "tsx src/Controls/tests/text-render.ts",
    "demo:gfont": "tsx src/Controls/tests/google-font-render.ts",
    "ge": "tsx src/applications/ge/main.ts",
    "clean": "rimraf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/opentype.js": "^1.3.9",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "opentype.js": "^2.0.0"
  }
}
