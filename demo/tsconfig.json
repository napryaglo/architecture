{
  // TypeScript for the demo application's LOGIC files (view-models,
  // services, behaviors, the registry). Authored as `.mts`, compiled to
  // `.mjs` in place so the browser loads them exactly as before — the
  // importmap + `.mu`/`.html` references keep pointing at `.mjs`. Thin
  // bootstrap `.mjs` entry files and generated `.mu.js` stay plain JS and
  // are NOT part of this program (only `**/*.mts` is included).
  //
  // The library (`@visualisation-sub/mural/*`) resolves through the
  // package `exports` map to its published `dist/**/*.d.ts` — i.e. demos
  // type-check against the SAME surface an external consumer sees. Run
  // `npm run build` (which builds dist) before/with the demo TS build.
  "compilerOptions": {
    "target": "esnext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["esnext", "dom", "dom.iterable"],

    "strict": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Emit `.mjs` next to each `.mts` source. No `outDir` on purpose: TS
    // auto-excludes the outDir, and pointing it at `.` would exclude the
    // whole demo tree. With no outDir, emit lands beside each source.
    "declaration": false,
    "sourceMap": false,
    "noEmitOnError": true
  },
  "include": ["**/*.mts"]
}
