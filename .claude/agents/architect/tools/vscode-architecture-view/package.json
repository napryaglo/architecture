{
  "name": "architecture-view",
  "displayName": "Architecture View",
  "description": "Syntax highlighting for the Pragmatic Architecture Framework .view DSL.",
  "publisher": "pragmatic-architecture",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "architecture-view",
        "aliases": ["Architecture View", "view"],
        "extensions": [".view"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "architecture-view",
        "scopeName": "source.architecture-view",
        "path": "./syntaxes/architecture-view.tmLanguage.json"
      }
    ]
  }
}
