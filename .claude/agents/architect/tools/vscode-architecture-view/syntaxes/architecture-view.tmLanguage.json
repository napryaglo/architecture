{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Architecture View",
  "scopeName": "source.architecture-view",
  "fileTypes": ["view"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#colors" },
    { "include": "#numbers" },
    { "include": "#connector-ops" },
    { "include": "#top-keywords" },
    { "include": "#layout-keywords" },
    { "include": "#placement-keywords" },
    { "include": "#anchor-names" },
    { "include": "#booleans" },
    { "include": "#references" },
    { "include": "#attribute-name" },
    { "include": "#enum-value" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.architecture-view",
          "match": "//.*$"
        },
        {
          "name": "comment.block.architecture-view",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.architecture-view",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.architecture-view",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "colors": {
      "patterns": [
        {
          "name": "constant.other.color.hex.architecture-view",
          "match": "#[0-9A-Fa-f]{3,8}\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.architecture-view",
          "match": "(?<![\\w$])-?\\d+(?:\\.\\d+)?\\b"
        }
      ]
    },
    "connector-ops": {
      "patterns": [
        {
          "name": "keyword.operator.connector.architecture-view",
          "match": "<-->|-->|<--|-\\||\\|-|--"
        }
      ]
    },
    "top-keywords": {
      "patterns": [
        {
          "name": "keyword.control.architecture-view",
          "match": "\\b(import|view|connectors|visual-library|technology-library)\\b"
        }
      ]
    },
    "layout-keywords": {
      "patterns": [
        {
          "name": "storage.type.layout.architecture-view",
          "match": "\\b(hstack|vstack|grid|ugrid|canvas|group|dock|wpf-grid)\\b"
        }
      ]
    },
    "placement-keywords": {
      "patterns": [
        {
          "name": "keyword.other.placement.architecture-view",
          "match": "\\b(at|horizontal|vertical|anchor|distance)\\b"
        }
      ]
    },
    "anchor-names": {
      "patterns": [
        {
          "name": "constant.language.anchor.architecture-view",
          "match": "\\b(north-east|north-west|south-east|south-west|north|south|east|west|center)\\b"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.architecture-view",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "match": "(\\$)([A-Za-z_][\\w\\-]*)(?:(\\.)([A-Za-z_][\\w\\-]*))?",
          "captures": {
            "1": { "name": "punctuation.definition.variable.architecture-view" },
            "2": { "name": "variable.other.reference.architecture-view" },
            "3": { "name": "punctuation.accessor.architecture-view" },
            "4": { "name": "support.constant.anchor.architecture-view" }
          }
        }
      ]
    },
    "attribute-name": {
      "patterns": [
        {
          "name": "variable.parameter.architecture-view",
          "match": "[A-Za-z_][\\w\\-]*(?=\\s*=)"
        }
      ]
    },
    "enum-value": {
      "patterns": [
        {
          "name": "support.constant.enum.architecture-view",
          "match": "(?<==\\s*)[A-Za-z_][\\w\\-]*"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.brace.architecture-view",   "match": "[{}]" },
        { "name": "punctuation.section.bracket.architecture-view", "match": "[\\[\\]]" },
        { "name": "punctuation.section.paren.architecture-view",   "match": "[()]" },
        { "name": "punctuation.separator.comma.architecture-view", "match": "," },
        { "name": "keyword.operator.assign.architecture-view",     "match": "=" },
        { "name": "punctuation.accessor.architecture-view",        "match": "\\." }
      ]
    }
  }
}
